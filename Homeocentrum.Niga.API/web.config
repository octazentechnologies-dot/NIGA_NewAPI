<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting for Homeocentrum.Niga.API.
  WebDAV must be removed: it intercepts PUT/DELETE/PATCH and returns IIS HTML 405
  (Allow: GET,HEAD,OPTIONS,TRACE) before AspNetCoreModule sees the request.
  Affects PatientProfile/Me and every other HttpPut/HttpDelete/HttpPatch endpoint.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <remove name="aspNetCore" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <security>
        <requestFiltering>
          <!-- Do not block PUT/DELETE/PATCH at the IIS requestFiltering layer. -->
          <verbs allowUnlisted="true" />
        </requestFiltering>
      </security>
      <aspNetCore processPath="dotnet" arguments=".\Homeocentrum.Niga.API.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="OutOfProcess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
