// =====================================================================================
// Homeocentrum API (.NET 10) - application settings.
// Settings are read once at startup. After changing any value, restart the site
// (IIS: recycle the HomeocentrumNewAPI app pool) for it to take effect.
// Lines starting with // are comments and are ignored by the app.
// =====================================================================================
{
  // JWT signing key (HMAC). Signs the tokens this API issues and verifies every incoming
  // Bearer token. Must be at least 32 characters and must be the SAME value as JWT:Secret
  // in the Old API, because the web UI signs in through the Old API and sends that token here.
  // Changing it signs out every user. Also used to derive the security-audit hash key.
  "TokenKey": "super secret unguessable key dfdfggsdrstrgs  dsfvddfdtryvssestrhttydd",

  // Standard .NET log level filters (Trace, Debug, Information, Warning, Error, Critical, None).
  // The file logger under Logs\ applies its own levels (see FeatureFlags:EnableDetailedLogging),
  // so these values mostly affect other log outputs.
  "Logging": {
    "LogLevel": {
      // Minimum level for all categories that have no more specific entry.
      "Default": "Information",
      // Minimum level for ASP.NET Core framework messages (keeps routine request noise out).
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Host names this API answers to (semicolon separated). "*" accepts any host name.
  "AllowedHosts": "*",

  // Feature switches. true = feature on, false = feature off.
  "FeatureFlags": {
    // true: Swagger UI (/swagger) and swagger.json are available, behind the SwaggerAuth login.
    // false: Swagger is not registered at all and /swagger returns 404. Use false on production if not needed.
    "EnableSwagger": true,
    // true: error responses (500) also contain an "exception" object with type, message, source,
    // stack trace and inner exceptions. Useful for debugging only.
    // false: clients only get a safe message and an errorId; full details stay in the log files.
    // Keep false on production.
    "ExposeExceptionDetails": true,
    // true: framework (Microsoft.*) logs at Information level and above go to the log files.
    // false: only framework Warning and above are written. App logs are not affected.
    "EnableDetailedLogging": true,
    // true: every request is logged (method, path, status, time) and the body of non-GET JSON/text
    // requests is logged (first 4000 characters, passwords and tokens redacted).
    // false: only failed or slow requests are logged.
    "EnableRequestLogging": false,
    // true: response bodies are logged (first 4000 bytes). Produces large log files; use for debugging.
    // false: response bodies are not logged.
    "EnableResponseLogging": false,
    // true: mobile numbers and e-mail addresses are written to logs unmasked, and Entity Framework
    // logs SQL parameter values with detailed errors. Passwords, tokens and secrets are always masked.
    // false: mobile numbers and e-mails are masked in logs. Keep false on production.
    "EnableSensitiveDataLogging": false,
    // true: security events (logins, failures, data changes) are written to the audit log.
    // false: the audit log is not written.
    "EnableAuditLogging": true,
    // true: POST api/Account/RefreshToken issues a new access token from a refresh token.
    // false: that endpoint returns 404 with code REFRESH_DISABLED and users must sign in again.
    "EnableRefreshToken": true,
    // true: request rate limit is enforced using RateLimit:PermitLimit and RateLimit:WindowSeconds
    // (HTTP 429 when exceeded). false: no rate limit. This is the only rate-limit on/off switch.
    "EnableRateLimiting": true,
    // true: browsers on other origins (for example the React UI) may call this API.
    // Origins come from an optional Cors:AllowedOrigins list; without it any origin is allowed.
    // false: no CORS headers are sent, so cross-origin browser calls are blocked.
    "EnableCors": true,
    // true: security response headers are added (X-Content-Type-Options, X-Frame-Options,
    // Referrer-Policy, X-Permitted-Cross-Domain-Policies). false: they are not added. X-Trace-Id is always sent.
    "EnableSecurityHeaders": true,
    // true: every API call returns 503 with MaintenanceMessage and Retry-After: 300; /health still works.
    // false: normal operation.
    "EnableMaintenanceMode": false,
    // Message shown to clients while EnableMaintenanceMode is true.
    "MaintenanceMessage": "The service is under maintenance. Please try again shortly.",
    // true: responses are gzip/brotli compressed when the client supports it (smaller and faster).
    // false: responses are sent uncompressed.
    "EnableResponseCompression": true,
    // true: background services run (disk space alert, daily issue e-mail, AI embedding jobs, and others).
    // false: none of the app's background services start; API requests still work.
    "EnableBackgroundJobs": true
  },

  // SQL Server database connection.
  "ConnectionStrings": {
    // Connection string for the Homeocentrum database. "Integrated Security=True" signs in with the
    // Windows account the site runs as (IIS app pool identity); use User Id/Password for SQL logins.
    "DefaultConnection": "Server=localhost\\MSSQLSERVER25;Database=HomeoCentrum_Dev;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },

  // Checks applied to uploaded files.
  "UploadSecurity": {
    // true: every upload is scanned with Windows Defender (MpCmdRun.exe) and infected files are rejected.
    // false: no virus scan.
    "AntivirusEnabled": true,
    // true: if the scanner is missing, fails or times out, the upload is rejected.
    // false: the upload is accepted and a warning is logged.
    "FailClosed": false,
    // Largest allowed upload, in megabytes.
    "MaxFileMegabytes": 100,
    // Seconds to wait for the virus scan of one file (allowed range 5 to 600).
    "ScanTimeoutSeconds": 60
  },

  // JSON Web Token (login token) settings.
  "JWT": {
    // Issuer written into tokens created by this API.
    "Issuer": "Homeocentrum.Niga.API",
    // Audience written into and required on every token. Must match JWT:Audience in the Old API.
    "Audience": "Homeocentrum.Niga.Client",
    // Token issuers this API accepts. Includes the Old API because the web UI signs in there.
    // The signing key is TokenKey at the top of this file.
    "ValidIssuers": [ "Homeocentrum.Niga.API", "Homeocentrum.Niga.OldAPI" ]
  },

  // Outgoing e-mail (OTP, password reset, notifications and alert e-mails).
  "smtp": {
    // Sender e-mail address shown in the From field.
    "from": "support.octazen@gmail.com",
    // SMTP server host name.
    "host": "smtp.gmail.com",
    // SMTP server port (587 = STARTTLS).
    "port": "587",
    // true: the server watchdog script (Watch-Homeocentrum.ps1) signs in to SMTP with the Windows account.
    // false: it uses userName/password. The API itself always uses userName/password.
    "defaultCredentials": false,
    // true: encrypt the SMTP connection (required by Gmail).
    "enableSsl": true,
    // SMTP login user name.
    "userName": "support.octazen@gmail.com",
    // SMTP password. For Gmail this is a 16-character App Password; spaces are ignored.
    "password": "tfpk pymi nutf ivqj",
    // Sender display name shown in the inbox. When empty, the "from" address is shown.
    "appName": "Niga Homeopathy"
  },

  // Log files under the site folder: Logs\<dd-MMM-yyyy>\.
  "FileLog": {
    // true: write log files. false: no log files are written.
    "Enabled": true
  },

  // Login required to open Swagger (/swagger). Only used while FeatureFlags:EnableSwagger is true.
  "SwaggerAuth": {
    // Swagger login user name.
    "Username": "Homeocentrum_Developer",
    // Swagger login password.
    "Password": "HomeocentrumDeveloper@12345"
  },

  // Request rate limit sizes. Turned on/off by FeatureFlags:EnableRateLimiting.
  // Signed-in users get one bucket each; anonymous callers get one bucket per IP.
  "RateLimit": {
    // Number of requests allowed per bucket in each window. Further requests get HTTP 429.
    "PermitLimit": 1000,
    // Length of the rate-limit window, in seconds.
    "WindowSeconds": 60
  },

  // CSRF protection for cookie-based sessions.
  "CookieCsrf": {
    // true: POST/PUT/PATCH/DELETE requests that carry a session cookie (and no Bearer token) must pass
    // the CSRF check. false: the CSRF check is off. Bearer-token calls are never affected.
    "Enabled": false
  },

  // Deploy notice e-mails.
  "DeployNotice": {
    // true: e-mail ErrorAlert:Recipients when the API starts, is ready and stops (shows a deploy happened).
    // false: no deploy e-mails.
    "Enabled": true
  },

  // Low disk space alert e-mails (sent to ErrorAlert:Recipients). Needs FeatureFlags:EnableBackgroundJobs.
  "DiskSpaceAlert": {
    // true: check free disk space regularly. false: no disk check.
    "Enabled": true,
    // Send an alert when a drive has this percent free space or less.
    "MinFreePercent": 10,
    // How often to check, in minutes.
    "CheckIntervalMinutes": 15,
    // While a drive stays low, repeat the alert every this many hours. One e-mail is sent when it recovers.
    "RepeatHours": 6,
    // Drives to check, for example [ "C:\\", "D:\\" ]. Empty list = every fixed drive.
    "Drives": []
  },

  // Error and warning alert e-mails.
  "ErrorAlert": {
    // true: e-mail Recipients immediately when a server error happens. false: no instant alerts.
    "Enabled": false,
    // true: send one summary e-mail at midnight with all issues of the day that ended.
    // false: no daily summary. Independent of Enabled.
    "DailyMatrixEnabled": true,
    // true: also e-mail for warnings (4xx errors, UI errors, slow requests). false: only server errors.
    "AlertOnWarn": true,
    // A successful request slower than this many milliseconds sends a performance warning. 0 = off.
    "SlowRequestMs": 3000,
    // Minimum minutes between two e-mails for the same issue. 0 = no throttling, every occurrence is e-mailed.
    "CooldownMinutes": 0,
    // E-mail addresses that receive error, deploy and disk alerts.
    "Recipients": [
      "support.octazen@gmail.com"
    ]
  },

  // Public address of the web UI. Used to build links in e-mails (password reset, invites, payment pages).
  // Keep exactly one SiteUrl active (uncommented) for the environment this API is deployed to.
  "ConfigurationModel": {
    // SiteUrl: base URL of the web UI used in e-mail links.
    "SiteUrl": "http://localhost:3000"
    //"SiteUrl": "https://devui.homeocentrum.com",
    //"SiteUrl": "https://devmaigrationui.homeocentrum.com"
    //"SiteUrl": "https://stageui.homeocentrum.com"
    //"SiteUrl": "https://nigaui.homeocentrum.com"
  },

  // AI repertory search (semantic embeddings) startup jobs. Need FeatureFlags:EnableBackgroundJobs.
  "AiEmbeddingInfrastructure": {
    // true: preload the semantic search cache when the API starts (faster first searches, slower startup).
    // false: the cache fills on demand.
    "EnableSemanticCacheWarmupOnStartup": false,
    // true: resume an unfinished embedding build automatically when the API starts.
    // false: unfinished builds wait until they are started again manually.
    "EnableAutoResumeEmbeddingBuildOnStartup": false
  },
  // TODO S5: confirm WhatsApp Meta AccessToken still valid. Already in API appsettings; S5 will use it.

  // Razorpay payment gateway (online payments and doctor payouts). Keys come from the Razorpay dashboard.
  "Razorpay": {
    // Public key id (rzp_live_... for live, rzp_test_... for test mode). Same account as the Old API.
    "KeyId": "rzp_live_WSDlLVrcCPFbEQ",
    // Secret key paired with KeyId. Keep private.
    "KeySecret": "Hxp0NS02jGsUt6cixbqoC6bB",
    // Secret used to verify Razorpay webhook calls (set the same value in the Razorpay webhook settings).
    // Empty = incoming webhooks are rejected with 503.
    "WebhookSecret": "",
    // RazorpayX account number used for doctor payouts. Empty = payouts produce a NEFT bank file instead.
    "PayoutAccountNumber": ""
  },

  // WhatsApp Business (Meta Cloud API) messages. Empty AccessToken or PhoneNumberId = WhatsApp off.
  "WhatsAppMeta": {
    // Permanent access token from Meta Business (System User token).
    "AccessToken": "",
    // WhatsApp phone number id that sends the messages (Meta > WhatsApp > API Setup).
    "PhoneNumberId": "",
    // WhatsApp Business Account id.
    "BusinessAccountId": "",
    // Meta Graph API version used in request URLs.
    "ApiVersion": "v23.0",
    // Country code (without +) added to 10-digit local mobile numbers. 91 = India.
    "DefaultCountryDialCode": "91"
  },

  // SMS sending (OTP and notifications).
  "Sms": {
    // SMS provider: Stub (no real SMS, logged only), Msg91 or Twilio.
    "Provider": "Msg91",
    // true: send SMS. false: SMS sending is off.
    "Enabled": true,
    // Country code (without +) added to 10-digit local mobile numbers. 91 = India.
    "DefaultCountryDialCode": "91",
    // MSG91 settings, used when Provider is Msg91. Needs AuthKey and SenderId.
    "Msg91": {
      // MSG91 account auth key.
      "AuthKey": "",
      // Approved 6-letter sender id shown on the phone.
      "SenderId": "",
      // MSG91 route. 4 = transactional.
      "Route": "4",
      // India DLT template id for OTP messages. Empty = plain text message.
      "OtpTemplateId": "",
      // India DLT registered entity id (principal entity id).
      "DltEntityId": ""
    },
    // Twilio SMS settings, used when Provider is Twilio.
    "Twilio": {
      // Twilio Account SID.
      "AccountSid": "",
      // Twilio Auth Token.
      "AuthToken": "",
      // Twilio phone number that sends the SMS, in +countrycode format.
      "FromNumber": ""
    }
  },

  // Video consultation (tele-consult) provider.
  "TeleVideo": {
    // Video provider: Stub (no real video), Agora, Twilio, Daily or 100ms. Only that provider's section is used.
    "Vendor": "100ms",
    // How long a video join token stays valid, in minutes.
    "TokenTtlMinutes": 60,
    // Agora settings, used when Vendor is Agora.
    "Agora": {
      // Agora project App ID.
      "AppId": "",
      // Agora App Certificate used to sign join tokens.
      "AppCertificate": ""
    },
    // Twilio Video settings, used when Vendor is Twilio.
    "Twilio": {
      // Twilio Account SID.
      "AccountSid": "",
      // Twilio API Key SID.
      "ApiKeySid": "",
      // Twilio API Key secret.
      "ApiKeySecret": ""
    },
    // Daily.co settings, used when Vendor is Daily.
    "Daily": {
      // Daily.co API key.
      "ApiKey": "",
      // Daily.co domain, for example yourname.daily.co.
      "Domain": ""
    },
    // 100ms.live settings, used when Vendor is 100ms (dashboard > Developer).
    "HundredMs": {
      // 100ms app access key.
      "AccessKey": "",
      // 100ms app secret, used with AccessKey to sign tokens.
      "AppSecret": "",
      // 100ms room template id; it defines which roles exist in each room.
      "TemplateId": "",
      // 100ms region for new rooms: in (India), us, eu or auto.
      "Region": "in",
      // 100ms REST API base URL.
      "ApiBaseUrl": "https://api.100ms.live/v2",
      // Template role name given to the doctor. Must match a role in the template.
      "DoctorRole": "host",
      // Template role name given to the patient. Must match a role in the template.
      "PatientRole": "guest",
      // Optional 100ms app subdomain (for example "homeocentrum") used for the prebuilt meeting link.
      "Subdomain": ""
    }
  }
}
